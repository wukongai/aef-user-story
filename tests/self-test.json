{
  "schema_version": "1.0",
  "tests": [
    {
      "id": "story-card-validator-requires-input",
      "script": "scripts/validate_story_card.py",
      "expected_exit": 2,
      "stdout_contains": [
        "[usage]",
        "validate_story_card.py <story-card.json>"
      ],
      "timeout_seconds": 10
    },
    {
      "id": "story-card-validator-contract",
      "script": "scripts/self_test.py",
      "expected_exit": 0,
      "stdout_json_keys": [
        "ok",
        "checks.valid_story_card_passes",
        "checks.invalid_story_card_fails",
        "checks.invalid_categories_covered",
        "checks.missing_acceptance_reference_reported"
      ],
      "stdout_contains": [
        "\"ok\": true"
      ],
      "timeout_seconds": 10
    }
  ]
}
